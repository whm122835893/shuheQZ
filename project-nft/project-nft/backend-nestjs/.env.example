# ===========================================
# 数和文创数字藏品平台 - 环境变量配置模板
# 使用方式：复制本文件为 .env 并填入实际值
# 密钥生成命令：openssl rand -hex 32
# ===========================================

# ---------- 运行环境 ----------
NODE_ENV=development               # 运行环境（development / production）

# ---------- 数据库配置 ----------
DB_TYPE=mysql                     # 数据库类型
DB_HOST=localhost                 # 数据库主机
DB_PORT=3306                      # 数据库端口
DB_USERNAME=root                  # 数据库用户名
DB_PASSWORD=                      # 数据库密码（生产环境必填）
DB_DATABASE=shuhe_wenchuang       # 数据库名
DB_SYNC=false                     # 是否自动同步表结构（生产环境必须 false）
DB_LOGGING=false                  # 是否打印 SQL 日志
DB_POOL_SIZE=10                   # 连接池大小

# ---------- Redis 配置 ----------
REDIS_HOST=localhost              # Redis 主机
REDIS_PORT=6379                   # Redis 端口
REDIS_PASSWORD=                   # Redis 密码（生产环境建议设置）

# ---------- JWT 配置 ----------
# ⚠️ 生产环境必须重新生成：openssl rand -hex 32
JWT_SECRET=<请替换为openssl生成的64位随机密钥>  # C端 JWT 密钥
JWT_EXPIRES_IN=7d                 # C端 JWT 过期时间
JWT_REFRESH_SECRET=<请替换为openssl生成的64位随机密钥>  # C端 JWT 刷新密钥
JWT_REFRESH_EXPIRES_IN=30d        # C端 JWT 刷新过期时间

# ---------- Admin JWT 配置 ----------
# ⚠️ 生产环境必须重新生成：openssl rand -hex 32
JWT_ADMIN_SECRET=<请替换为openssl生成的64位随机密钥>  # 管理后台 JWT 密钥

# ---------- AES 数据加密密钥 ----------
# ⚠️ 必须为 32 字符，生产环境必须重新生成
DATA_AES_KEY=<请替换为32字符随机密钥>  # 敏感数据加密密钥

# ---------- CORS 白名单 ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173  # 允许的跨域来源（逗号分隔，生产环境必须配置）

# ---------- Cookie 认证配置 ----------
# Token 存储在 httpOnly Cookie 中，防止 XSS 窃取
# 生产环境：sameSite=none + secure=true（跨域 HTTPS）
# 开发环境：sameSite=lax（同源或开发环境自动降级）
# COOKIE_DOMAIN=.example.com  # Cookie 作用域名（如 .example.com），不设置则默认当前域名
# COOKIE_SECURE=true           # 强制 HTTPS 传输（生产环境自动 true）
# COOKIE_SAMESITE=none         # sameSite 策略：none / lax / strict

# ---------- 请求超时控制 ----------
REQUEST_TIMEOUT_MS=30000  # 全局请求超时时间（毫秒），默认 30 秒

# ---------- 支付安全开关 ----------
PAYMENT_DEV_MODE=false            # 支付开发模式（生产环境必须 false）

# ---------- 实名认证开关 ----------
REALNAME_DEV_MODE=false           # 实名认证开发模式（生产环境必须 false）

# ---------- 短信服务配置 ----------
SMS_ACCESS_KEY=                   # 短信服务商 AccessKey
SMS_SECRET=                        # 短信服务商 Secret

# ---------- 支付宝配置 ----------
ALIPAY_APP_ID=                    # 支付宝 App ID
ALIPAY_PRIVATE_KEY=               # 支付宝私钥
ALIPAY_PUBLIC_KEY=                # 支付宝公钥

# ---------- 微信支付配置 ----------
WECHAT_MCH_ID=                    # 微信商户号
WECHAT_APP_ID=                    # 微信 App ID
WECHAT_PUBLIC_KEY=                # 微信支付公钥
WECHAT_API_V3_KEY=                # 微信支付 API V3 密钥

# ---------- 文件存储配置 ----------
UPLOAD_ENDPOINT=                   # 文件上传端点
UPLOAD_BUCKET=                     # 存储桶名称
UPLOAD_ACCESS_KEY=                 # 上传 AccessKey
UPLOAD_SECRET_KEY=                 # 上传 SecretKey

# ---------- 站点配置 ----------
SITE_URL=http://localhost:3000     # 站点地址
