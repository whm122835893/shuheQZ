# ===========================================
# 数和文创数字藏品平台 - .gitignore
# ===========================================

# ---------- 依赖目录 ----------
node_modules/
**/node_modules/

# ---------- 构建产物 ----------
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# ---------- 环境变量与密钥 ----------
.env
.env.local
.env.*.local
.env.production
!.env.example

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 日志文件 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 运行时文件 ----------
*.pid
*.seed
*.pid.lock
pids/

# ---------- 测试覆盖率 ----------
coverage/
.nyc_output/

# ---------- 缓存 ----------
.cache/
.parcel-cache/
.eslintcache
.tmp/
tmp/

# ---------- 上传文件 (用户上传内容不入库) ----------
uploads/
!**/assets/icons/
!**/assets/lottery/

# ---------- 数据库备份 ----------
*.sql.bak
*.sql.gz
db_backup/

# ---------- OS 文件 ----------
.DS_Store
ehthumbs.db
Desktop.ini

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- 包管理锁文件 (保留 package-lock.json) ----------
# yarn.lock
# pnpm-lock.yaml
